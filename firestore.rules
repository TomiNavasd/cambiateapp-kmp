rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(datos) {
      return request.auth != null && datos.userId == request.auth.uid;
    }

    match /prendas/{prendaId} {
      allow read: if esDueno(resource.data);
      allow create: if esDueno(request.resource.data);
      allow update: if esDueno(resource.data)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if esDueno(resource.data);
    }

    match /outfits/{outfitId} {
      allow read: if esDueno(resource.data);
      allow create: if esDueno(request.resource.data);
      allow update: if esDueno(resource.data)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if esDueno(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}